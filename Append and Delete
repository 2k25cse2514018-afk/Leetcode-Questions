Append and Delete

string appendAndDelete(string s, string t, int k) {
    int i = 0;
    int tCount = 0;
    int sCount = 0;

    for(i = 0; i < s.size() && i < t.size(); i++) {
        if(s[i] == t[i]) {
            continue;
        }
        else {
            break;
        }
    }

    sCount = s.size() - i;
    tCount = t.size() - i;

    if(k >= tCount + sCount && (k - (sCount + tCount)) % 2 == 0) {
        return "Yes";
    }

    if(k >= s.size() + t.size()) {
        return "Yes";
    }

    return "No";
}
