
class Solution {
public:
    ListNode* reverseKGroup(ListNode* head, int k) {
        vector<int> ans;
        ListNode*temp=head;
        while(temp){
            ans.push_back(temp->val);
            temp=temp->next;
        }

        for(int i=0;i+k<=ans.size();i+=k){
            reverse(ans.begin()+i,ans.begin()+i+k);
        }
        temp=head;
        int i=0;

        while(temp){
            temp->val=ans[i++];
            temp=temp->next;
        }
        return head;
    }
};

