class Solution {
public:
    vector<int> nextLargerNodes(ListNode* head) {
        vector<int> ans;
        vector<int> last;
        ListNode* temp = head;

        while(temp) {
            ans.push_back(temp->val);
            temp = temp->next;
        }

        for(int i=0; i<ans.size();i++) {
            bool found=false;

            for(int j = i+1; j < ans.size(); j++) {
                if(ans[j] > ans[i]) {
                    last.push_back(ans[j]);
                    found=true;
                    break;
                }
            }

            if(!found) {
                last.push_back(0);
            }
        }

        return last;
    }
};
