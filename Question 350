class Solution {
public:
    vector<int> intersect(vector<int>& nums1, vector<int>& nums2) {
        unordered_map<int,int> mpp;
        vector<int> ans;
        for(int i:nums1){
            mpp[i]++;
        }
        for(int i:nums2){
            if(mpp[i]>=1){
                ans.push_back(i);
                mpp[i]--;
            }
        }
        return ans;
    }
};
