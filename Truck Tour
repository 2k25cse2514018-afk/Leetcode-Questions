int truckTour(vector<vector<int>> petrolpumps) {
    long long cur = 0;
    int start = 0;
    for (int i = 0; i < petrolpumps.size(); i++) {
        cur += (long long)petrolpumps[i][0] - petrolpumps[i][1];
        if (cur < 0) {
            start = i + 1;
            cur = 0;
        }
    }
    return start;
}
