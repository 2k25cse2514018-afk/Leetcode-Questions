class Solution {
public:
    int numOfSubarrays(vector<int>& arr) {
        int ans=0;
        int odd_count=0;
        int even_count=1;
        int sum=0;

        for(int i=0;i<arr.size();i++){
            sum+=arr[i];

            if(sum%2!=0){
                ans+=even_count;
                odd_count++;
            }
            else{
                ans+=odd_count;
                even_count++;
            }
            const int mod = 1e9 + 7;
            ans %= mod;
        }
        return ans;
    }
};
