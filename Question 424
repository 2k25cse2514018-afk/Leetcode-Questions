class Solution {
public:
    int characterReplacement(string s, int k) {
        int start=0;
        int max_freq=0;
        int result=0;
        unordered_map<char,int> freq_map;

        for(int i=0;i<s.size();i++){
            freq_map[s[i]]++;
            max_freq=max(max_freq,freq_map[s[i]]);

            if(i-start+1-max_freq>k){
                freq_map[s[start]]--;
                start++;
            }
            result=max(result,i-start+1);
        }
        return result;
    }
};
