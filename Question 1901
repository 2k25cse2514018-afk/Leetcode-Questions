class Solution {
public:
    vector<int> findPeakGrid(vector<vector<int>>& mat) {
        int r=mat.size();
        int c=mat[0].size();

        int low=0;
        int high=c-1;

        while(low<=high){
            int mid=low+(high-low)/2;
             int index=0;
             int max_val=-1;
             for(int i=0;i<r;i++){
                if(mat[i][mid]>max_val){
                    max_val=mat[i][mid];
                    index=i;
                }
             }
             int left=0;
             int right=0;
             if(mid-1>=0){
                left=mat[index][mid-1];
             }
             else{
                left=-1;
             }

             if(mid+1<c){
                right=mat[index][mid+1];
             }
             else{
                right=-1;
             }
             if(mat[index][mid]>left &&  mat[index][mid]>right){
                return{index,mid};
             }
             else if(mat[index][mid]>left && mat[index][mid]<right){
                low=mid+1;
             }
             else{
                high=mid-1;
             }
        }
        return {-1,-1};
    }
};
