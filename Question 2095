class Solution {
public:
    ListNode* deleteMiddle(ListNode* head) {
        if(head==NULL||head->next==NULL){
            return NULL;
        }
        ListNode*t1=head;
        int count=0;
        while(t1){
            count++;
            t1=t1->next;
        }
        int mid=ceil((count)/2);
        ListNode*temp=head;
        ListNode*prev=NULL;

        while(mid!=0){
            prev=temp;
            temp=temp->next;
            mid--;
        }
        prev->next=temp->next;
        delete(temp);
        return head;
    }
};



Another Way

class Solution {
public:
    ListNode* deleteMiddle(ListNode* head) {
        if(head==NULL||head->next==NULL){
            return NULL;
        }
        ListNode*slow=head;
        ListNode*fast=head;
        fast=fast->next->next;

        while(fast!=NULL && fast->next!=NULL){
            slow=slow->next;
            fast=fast->next->next;
        }
        ListNode*middle=slow->next;
        slow->next=middle->next;
        delete(middle);

        return head;
    }
};
