class Solution {
public:
    ListNode* reverseList(ListNode* head) {
        vector<int>ans;
        ListNode*temp=head;
        while(temp){
            ans.push_back(temp->val);
            temp=temp->next;
        }
        reverse(ans.begin(),ans.end());
        temp=head;
        for(int i=0;i<ans.size();i++){
            temp->val=ans[i];
            temp=temp->next;
        }
        return head;
    }
};
