class Solution {
public:
    int smallestDivisor(vector<int>& nums, int threshold) {
        int n = nums.size();

        int low=1;
        int high=INT_MIN;
        for(int i=0;i<n;i++){
            high=max(high,nums[i]);
        }

        while(low<=high){
            int mid=low+(high-low)/2;

            int sum=0;
            for(int i=0;i<n;i++){
                sum+=ceil((double)nums[i]/mid);
            }
            if(sum>threshold){
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
        return low;
    }
};
