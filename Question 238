class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
        vector<int> ans;
        int total = 1;
        int count = 0;

        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] == 0) {
                count++;
            } else {
                total *= nums[i];
            }
        }

        for (int i = 0; i < nums.size(); i++) {
            if (count > 1) {
                ans.push_back(0);
            }
            else if (count == 1) {
                if (nums[i] == 0)
                    ans.push_back(total);
                else
                    ans.push_back(0);
            }
            else {
                ans.push_back(total / nums[i]);
            }
        }

        return ans;
    }
};
