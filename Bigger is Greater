string biggerIsGreater(string w) {
    int jb=-1;
    for(int i=w.size()-2;i>=0;i--){
        if(w[i]<w[i+1]){
            jb=i;
            break;
        }
    }
    
    if(jb==-1){
            return "no answer";
        }
        
    int j=w.size()-1;
        while(w[jb]>=w[j]){
            j--;
        }
    swap(w[jb],w[j]);
    reverse(w.begin()+jb+1,w.end());
    return w;

}
