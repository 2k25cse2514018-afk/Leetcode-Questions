class Solution {
public:
    bool hasCycle(ListNode *head) {

        if(head==NULL||head->next==NULL){
            return false;
        }
        unordered_map<ListNode*,int> mpp;
        ListNode*temp=head;
        while(temp){
            mpp[temp]++;
            if(mpp[temp]>1){
                return true;
            }
            temp=temp->next;
        }
        return false;
    }
};

Another way

class Solution {
public:
    bool hasCycle(ListNode *head) {
        ListNode*slow=head;
        ListNode*fast=head;

        while(fast!=NULL&&fast->next!=NULL){
            slow=slow->next;
            fast=fast->next->next;

            if(slow==fast){
                return true;
            }
        }
        return false;
    }
};
