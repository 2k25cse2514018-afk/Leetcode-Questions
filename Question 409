class Solution {
public:
    int longestPalindrome(string s) {
       map<char,int>mpp;
       for(int i=0;i<s.size();i++){
        mpp[s[i]]++;
       }
       int odd_count=0;
       int count=0;
       for(auto i:mpp){
        if(i.second%2==0){
            count+=i.second;
        }
        else { 
            count += i.second - 1; odd_count = 1; 
            }

       }
       return  count + odd_count;
    }
};
