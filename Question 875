class Solution {
public:
    int minEatingSpeed(vector<int>& piles, int h) {


        int n = piles.size();
        int low=1;

        int maxi=INT_MIN;
        for(int i=0;i<n;i++){
            maxi=max(maxi,piles[i]);
        }
        int high=maxi;
        

        while(low<=high){
            int mid=low+(high-low)/2;
            
            long long hours=0;
            for(int i=0;i<n;i++){
                hours+=ceil((double)piles[i]/mid);
            }

            if(hours<=h){
                high=mid-1;
            }
            else{
                low=mid+1;
            }
        }
        return low;
    }
};
