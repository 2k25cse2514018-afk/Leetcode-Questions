class Solution {
public:
    int minimumSize(vector<int>& nums, int maxOperations) {
        int low=1;
        int high=*max_element(nums.begin(),nums.end());

    while(low<=high){
        int mid=low+(high-low)/2;
    long long op=0;
    for(int i=0;i<nums.size();i++){
        op+=(nums[i]-1)/mid;
    }
    if(op<=maxOperations){
        high=mid-1;
    }
    else{
        low=mid+1;
    }
    }
    
    return low;
    }
};
