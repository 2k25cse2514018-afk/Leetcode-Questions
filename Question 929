class Solution {
public:
    int numUniqueEmails(vector<string>& emails) {
        unordered_set<string> myset;
        for(string email:emails){
            int size=email.size();
            string domain="";
            string front="";
            for(int i=0;i<size;i++){
                
                if(email[i]=='.'){
                    continue;
                }
                if(email[i]=='+'||email[i]=='@'){
                    break;
                }
                front+=email[i];

                }

                 for(int i=size-1;i>=0;i--){
                    domain+=email[i];
                    if(email[i]=='@'){
                        break;
                    }


                
                
            }
            reverse(domain.begin(),domain.end());
            front+=domain;
            
            myset.insert(front);
           
        }
         return myset.size();
    }
};
