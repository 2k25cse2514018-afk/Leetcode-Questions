class Solution {
public:
    vector<int> fairCandySwap(vector<int>& aliceSizes, vector<int>& bobSizes) {
        int sum1 = 0, sum2 = 0;

        for(int i = 0;i<aliceSizes.size();i++) {
            sum1+=aliceSizes[i];
        }

        for(int i=0;i<bobSizes.size();i++) {
            sum2 += bobSizes[i];
        }

        int diff=(sum1-sum2)/2;

        set<int> s;

        for(int i=0;i<bobSizes.size();i++) {
            s.insert(bobSizes[i]);
        }

        for(int i=0;i<aliceSizes.size();i++) {
            int x=aliceSizes[i];
            int y=x-diff;

            if(s.find(y)!=s.end()) {
                return {x, y};
            }
        }

        return {};
    }
};
