class Solution {
public:
    bool checkPrimeFrequency(vector<int>& nums) {
        unordered_map<int,int> mpp;

        for(int i=0;i<nums.size();i++){
            mpp[nums[i]]++;
        }

        for(auto it : mpp){
            int freq=it.second;
            bool prime=true;

            if(freq<=1){
                prime=false;
            }

            for(int i=2;i*i<=freq;i++){
                if(freq%i==0){
                    prime = false;
                    break;
                }
            }

            if(prime){
                return true;
            }
        }

        return false;
    }
};
