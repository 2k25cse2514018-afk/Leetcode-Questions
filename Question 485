class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int count=0;
        int second=0;
        int n=nums.size();

        for(int i=0;i<n;i++){
            if(nums[i]==1){
                count++;
            }
            else if(nums[i]==0){
                second=max(count,second);
                count=0;
            }
        }
        return max(count,second);
        
    }
};
