
class Solution {
public:
    int minSubArrayLen(int target, vector<int>& nums) {
        int n=nums.size();
        int start=0;
        int end=0;
        int sum=0;
        int result=INT_MAX;

        while(end<n){
            sum+=nums[end];

            while(sum>=target){
                result=min(end-start+1,result);
                sum-=nums[start];
                start++;
            }
            end++;
        }

        if(result==INT_MAX){
            return 0;
        }
        return result;
    }
};
