class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        int n=nums.size();
        vector<int> ans(n,0);
        int postive=0;
        int negative=1;

        for(int i=0;i<n;i++){
            if(nums[i]<0){
                ans[negative]=nums[i];
                negative =negative + 2;
            }
            else{
                ans[postive]=nums[i];
                postive =postive + 2;
            }
        }
        return ans;
    }
};
