class Solution {
public:
    vector<int> twoSum(vector<int>& numbers, int target) {
        unordered_map<int,int> mpp;
        for(int i=0;i<numbers.size();i++){

            int final=target-numbers[i];
            if(mpp.find(final)!=mpp.end()){
                return {mpp[final]+1,i+1};
            }
            mpp[numbers[i]]=i;
        }

        
        return {};
    }
};
