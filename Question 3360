class Solution {
public:
    bool canAliceWin(int n) {
        int count=0;
        int ans=10;
        while(n>=0){
            n=n-ans;
            if(n>=0){
                count++;
                ans--;
            }
        }
        if(count%2==1){
            return true;
        }
        return false;
    }
};
