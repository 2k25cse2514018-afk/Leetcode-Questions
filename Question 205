class Solution {
public:
    bool isIsomorphic(string s, string t) {
        vector<int>arr1(500,-1);
        vector<int>arr2(500,-1);
        if(s.size()!=t.size()){
            return false;
        }
        for(int i=0;i<s.size();i++){
            char c1=s[i];
            char c2=t[i];
            if(arr1[c1]!=arr2[c2]){
                return false;
            }
            arr1[c1]=arr2[c2]=i;
        }
        return true;
    }
};
