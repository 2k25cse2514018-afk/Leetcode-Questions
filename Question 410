class Solution {
public:
    int splitArray(vector<int>& nums, int k) {
        int n = nums.size();
        if(n<k){
            return -1;
        }
        int low=0;
        int high=0;

        for(int i=0;i<n;i++){
            low=max(low,nums[i]);
            high+=nums[i];
        }

        while(low<=high){
            int mid=low+(high-low)/2;

            int arraySplit=1;
            int maxSum=0;

            for(int i=0;i<n;i++){
                if(maxSum+nums[i]<=mid){
                    maxSum=maxSum+nums[i];
                }
                else{
                    arraySplit++;
                    maxSum=nums[i];
                }

            }
            if(arraySplit>k){
                    low=mid+1;;
                }
                else{
                    high=mid-1;
                }
        }
        return low;
    }
};
