class Solution {
public:
    bool judgeSquareSum(int c) {
        long long low=0;
        long long high=sqrt(c);
        while(low<=high){
            if((high*high)+(low*low)==c){
                return true;
            }
            else if((high*high)+(low*low)>c){
                high--;
            }
            else{
                low++;
            }
        }
        return false;
    }
};
