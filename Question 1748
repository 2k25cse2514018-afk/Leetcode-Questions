class Solution {
public:
    int sumOfUnique(vector<int>& nums) {
        unordered_map<int,int> mpp;
        for(int i=0;i<nums.size();i++){
            mpp[nums[i]]++;
        }

        int sum=0;

        for(auto i:mpp){
            if(i.second==1){
                sum+=i.first;
            }
        }
        return sum;
    }
};

Another way

class Solution {
public:
    int sumOfUnique(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        int sum=0;
       
        for(int i=0;i<nums.size();i++){
             if((i==0 || nums[i]!=nums[i-1]) && 
               (i==nums.size()-1 || nums[i]!=nums[i+1])){
                sum+=nums[i];
            }
        }
        return sum;
    }
};
