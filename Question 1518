class Solution {
public:
    int numWaterBottles(int numBottles, int numExchange) {
        int total=numBottles;
        while(numBottles>=numExchange){
            int newB=numBottles/numExchange;
            int rem=numBottles%numExchange;

            total+=newB;
            numBottles=newB+rem;
        }
        return total;
    }
};
