class Solution {
public:
    int singleNumber(vector<int>& nums) {
        map<int,int> mpp;
        int find=0;
        int n = nums.size();

        for(int i=0;i<n;i++){
            mpp[nums[i]]++;
        }

        for(auto i: mpp){
            if(i.second==1){
                find=i.first;
            }
        }
        return find;
        
    }
};


