class Solution {
public:
    ListNode* insertGreatestCommonDivisors(ListNode* head) {
        ListNode*curr=head;

        while(curr!=NULL&&curr->next!=NULL) {
            int g = gcd(curr->val,curr->next->val);
            ListNode* temp=new ListNode(g);
            temp->next=curr->next;
            curr->next=temp;
            curr=temp->next;
        }

        return head;
    }
};
