class Solution {
public:
ListNode* partition(ListNode* head, int x) {
ListNode small(0);
ListNode large(0);


    ListNode* s = &small;
    ListNode* l = &large;

    while (head != NULL) {
        if (head->val < x) {
            s->next = head;
            s = s->next;
        } else {
            l->next = head;
            l = l->next;
        }

        head = head->next;
    }

    l->next = NULL;
    s->next = large.next;

    return small.next;
}


};
